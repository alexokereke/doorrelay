# For Ring Playground video: paste a fresh token, then restart npm run dev.
RING_ACCESS_TOKEN=
# Production/shared-network dashboard access. Browser username: household
DOORRELAY_APP_PASSWORD=
# Signed Ring notifications: use the HMAC signing key from Ring partner credentials.
RING_HMAC_SIGNING_KEY=
# Test events enabled in development. Production defaults to false.
# DOORRELAY_ENABLE_TEST_EVENTS=true
# Persistent local storage directory; default is .doorrelay under the project.
# DOORRELAY_DATA_DIR=/path/to/persistent/doorrelay
# Full partner authentication alternative (do not set both modes):
# RING_REFRESH_TOKEN=
# RING_CLIENT_ID=
# RING_CLIENT_SECRET=
